# NxtWave AI Workshop Growth Engine — environment template
# Local demo works out of the box with these defaults.

# SQLite (zero-setup local demo). For production, point this at
# PostgreSQL / Supabase (see supabase/schema.sql for raw-SQL setup).
DATABASE_URL="file:./db/custom.db"

# Admin console password (/admin login)
ADMIN_PASSWORD="12345"

# Runs the app in demo mode with seeded data + visible demo badge
NEXT_PUBLIC_DEMO_MODE="true"
