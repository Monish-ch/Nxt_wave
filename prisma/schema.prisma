generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = Amazon Linux 2023 (Vercel serverless runtime)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Registrations: one row per student registered for the workshop.
// `referralCode` is the student's OWN shareable code (NXW-XXXXNN).
// `referredById` points at the student who referred them (null = direct).
// ---------------------------------------------------------------------------
model Registration {
  id             String        @id @default(uuid())
  fullName       String
  email          String        @unique
  whatsapp       String?
  college        String?
  branch         String?
  graduationYear Int?
  source         String? // ambassador | club | whatsapp | referral | instagram | other
  sourceCode     String? // e.g. RAHUL01, CSECLUB01, UTM code
  shareVariant   String? // A/B invite-message style that landed this signup: friendly | achievement | urgent
  referralCode   String        @unique
  referredById   String?
  referredBy     Registration? @relation("ReferralChain", fields: [referredById], references: [id], onDelete: SetNull)
  directReferrals Registration[] @relation("ReferralChain")
  // Outreach hygiene: while set (and in the future), nudge bulk actions and
  // queue prioritization skip this student — "don't double-touch them".
  snoozedUntil   DateTime?
  createdAt      DateTime      @default(now())

  referralsGiven Referral[] @relation("ReferrerReferrals")
  referralsReceived Referral[] @relation("ReferredReferrals")
  nudgeLogs Nudge[] @relation("RegistrationNudges")

  @@index([createdAt])
  @@index([source])
  @@index([college])
  @@index([referredById])
  @@index([shareVariant])
}

// ---------------------------------------------------------------------------
// Referrals: immutable ledger of one student referring another.
// One row per successful referred registration.
// ---------------------------------------------------------------------------
model Referral {
  id          String       @id @default(uuid())
  referrerId  String
  referredId  String       @unique
  referralCode String
  status      String       @default("completed") // completed | pending | revoked
  createdAt   DateTime     @default(now())

  referrer Registration @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Registration @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Campaign sources: acquisition channels (campus ambassadors, clubs, etc.)
// ---------------------------------------------------------------------------
model CampaignSource {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      String // human | community | social | other
  ownerName String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Milestones: referral gamification tiers (1 / 3 / 5 / 10 referrals).
// ---------------------------------------------------------------------------
model Milestone {
  id            String @id @default(uuid())
  name          String
  referralCount Int    @unique
  rewardText    String
}

// ---------------------------------------------------------------------------
// Digests: audit log for channel-owner digests. Each row records one digest
// copy "handed off" (copied send-ready text) to a channel owner — mirrors the
// nudge audit trail so the digest outreach is measurable too.
// ---------------------------------------------------------------------------
model DigestLog {
  id        String   @id @default(uuid())
  code      String // CampaignSource.code the digest was composed for
  message   String? // exact copy handed to the owner (null = not captured)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Nudges: outreach log for the WhatsApp reminder simulator. Each row records
// one reminder sent to a student who is one referral away from their next
// milestone ("near-miss" nudge queue in the Growth Console).
// ---------------------------------------------------------------------------
model Nudge {
  id             String       @id @default(uuid())
  registrationId String
  channel        String       @default("whatsapp") // whatsapp | other (simulated)
  message        String?
  createdAt      DateTime     @default(now())

  registration Registration @relation("RegistrationNudges", fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([createdAt])
}
